# ==============================================================================
# FORMA360 — VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a `.env.local` en local o configura estas claves en Vercel
# (Project Settings -> Environment Variables).
# NUNCA incluyas secretos reales en este archivo ni en el repositorio Git.

# 1. URL pública de tu proyecto Supabase (ej. https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# 2. Clave pública anónima (anon/publishable key) de Supabase
# Segura para el navegador siempre que las políticas RLS estén activas
# (ejecuta antes las migraciones SQL de `supabase/migrations/`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 3. Clave privada de administración de Supabase (OPCIONAL — SOLO SERVIDOR)
# Necesaria únicamente si deseas que `/api/account` elimine también el usuario de
# `auth.users` además de borrar todos sus datos relacionales y fotos privadas.
# NUNCA añadas el prefijo NEXT_PUBLIC_ a esta clave.
SUPABASE_SERVICE_ROLE_KEY=

# 4. Bucket privado de Supabase Storage para fotografías de progreso (opcional)
NEXT_PUBLIC_SUPABASE_PROGRESS_BUCKET=progress-photos

# 5. Zona horaria por defecto de la aplicación
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/Madrid

# 6. URL canónica de la aplicación para redirecciones de confirmación de correo
NEXT_PUBLIC_SITE_URL=http://localhost:3000
